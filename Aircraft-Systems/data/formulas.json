  "module": "m07",
  "name": {
   "vi": "Checksum",
   "en": "Checksum"
  },
  "latex": "\\text{checksum}=\\left(\\sum_i b_i\\right)\\bmod 256",
  "legend": {
   "vi": "b_i: byte thứ i.",
   "en": "b_i: i-th byte."
  },
  "src": "Tooley Ch.13; Floyd §11-11"
 },
 {
  "id": "f14",
  "module": "m07",
  "name": {
   "vi": "Xác suất theo mức hỏng",
   "en": "Probability by failure level"
  },
  "latex": "A<10^{-9},\\quad B:10^{-9}\\ \\text{đến}\\ 10^{-7},\\quad C:10^{-7}\\ \\text{đến}\\ 10^{-5},\\quad D>10^{-5}",
  "legend": {
   "vi": "Xác suất cho phép của hỏng; mức A nghiêm trọng nhất.",
   "en": "Allowed failure probability; level A is the most severe."
