  "latex": "n\\ \\text{đầu vào}\\rightarrow 2^n\\ \\text{đầu ra}",
  "legend": {
   "vi": "",
   "en": ""
  },
  "src": "Tooley Ch.9; Floyd Ch.6"
 },
 {
  "id": "f09",
  "module": "m04",
  "name": {
   "vi": "Dung lượng bộ nhớ",
   "en": "Memory capacity"
  },
  "latex": "\\text{số ô}=2^{a},\\qquad \\text{bit}=2^{a}\\times w",
  "legend": {
   "vi": "a: số đường địa chỉ; w: số bit mỗi ô.",
   "en": "a: number of address lines; w: bits per cell."
