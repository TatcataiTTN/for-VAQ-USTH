   "en": "n: number of input variables."
  },
  "src": "Floyd Ch.3"
 },
 {
  "id": "f06",
  "module": "m02",
  "name": {
   "vi": "Biên chống nhiễu",
   "en": "Noise margin"
  },
  "latex": "V_{NH}=V_{OH(min)}-V_{IH(min)},\\qquad V_{NL}=V_{IL(max)}-V_{OL(max)}",
  "legend": {
