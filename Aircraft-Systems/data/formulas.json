  "src": "Module 04, bài giảng"
 },
 {
  "id": "f11",
  "module": "m05",
  "name": {
   "vi": "Thời gian truyền một từ ARINC 429",
   "en": "Transmission time of one ARINC 429 word"
  },
  "latex": "t=\\dfrac{32}{R}\\quad(R=12{,}5\\ \\text{kbps}\\Rightarrow 2{,}56\\ \\text{ms};\\ R=100\\ \\text{kbps}\\Rightarrow 0{,}32\\ \\text{ms})",
  "legend": {
   "vi": "R: tốc độ bit.",
   "en": "R: bit rate."
  },
  "src": "Tooley Ch.4; Module 05"
 },
 {
  "id": "f12",
  "module": "m06",
  "name": {
