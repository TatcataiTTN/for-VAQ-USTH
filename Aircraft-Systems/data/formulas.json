  "src": "Tooley Bảng 13.1"
 },
 {
  "id": "f15",
  "module": "m08",
  "name": {
   "vi": "Định luật Snell",
   "en": "Snell's law"
  },
  "latex": "n_1\\sin\\theta_1=n_2\\sin\\theta_2",
  "legend": {
   "vi": "n: chiết suất; θ: góc so với pháp tuyến.",
   "en": "n: refractive index; θ: angle from the normal."
  },
  "src": "Tooley §10.2; Module 08"
 },
 {
  "id": "f16",
  "module": "m08",
  "name": {
   "vi": "Góc tới hạn",
   "en": "Critical angle"
  },
  "latex": "\\sin\\theta_c=\\dfrac{n_2}{n_1}",
  "legend": {
   "vi": "n_1 > n_2.",
   "en": "n_1 > n_2."
  },
  "src": "Tooley §10.2"
 },
 {
  "id": "f17",
  "module": "m08",
  "name": {
   "vi": "Khẩu độ số và góc chấp nhận",
