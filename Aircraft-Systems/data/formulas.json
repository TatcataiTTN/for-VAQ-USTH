  "latex": "NA=\\sqrt{n_1^2-n_2^2}=\\sin\\theta_a",
  "legend": {
   "vi": "Trong không khí.",
   "en": "In air."
  },
  "src": "Tooley §10.2"
 },
 {
  "id": "f18",
  "module": "m08",
  "name": {
   "vi": "Tần số chuẩn hoá và số mode",
   "en": "Normalised frequency and number of modes"
